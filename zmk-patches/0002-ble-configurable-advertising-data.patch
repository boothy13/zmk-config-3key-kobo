diff --git a/app/Kconfig b/app/Kconfig
index 2dbfa9bf..49d7de43 100644
--- a/app/Kconfig
+++ b/app/Kconfig
@@ -183,6 +183,17 @@ config ZMK_BLE_ALLOW_LEGACY_PAIRING
       legacy pairing. Enabling this lets those hosts pair; hosts that support
       Secure Connections still use it.
 
+config ZMK_BLE_ADV_APPEARANCE
+    bool "Include the GAP appearance (CONFIG_BT_DEVICE_APPEARANCE) in BLE advertising"
+    default y
+
+config ZMK_BLE_ADV_SERVICE_UUIDS
+    bool "Include the HID and Battery service UUIDs in BLE advertising"
+    default y
+
+config ZMK_BLE_ADV_NAME_IN_SCAN_RSP
+    bool "Send the device name in the scan response instead of the advertising packet"
+
 config ZMK_BLE_PASSKEY_ENTRY
     bool "Require passkey entry on the keyboard to complete pairing"
     select RING_BUFFER
diff --git a/app/src/ble.c b/app/src/ble.c
index 2611eee5..8819e4db 100644
--- a/app/src/ble.c
+++ b/app/src/ble.c
@@ -55,9 +55,14 @@ enum advertising_type {
 
 #define CURR_ADV(adv) (adv << 4)
 
+#if IS_ENABLED(CONFIG_ZMK_BLE_ADV_NAME_IN_SCAN_RSP)
+#define ZMK_ADV_NAME_OPTS BT_LE_ADV_OPT_USE_NAME
+#else
+#define ZMK_ADV_NAME_OPTS (BT_LE_ADV_OPT_USE_NAME | BT_LE_ADV_OPT_FORCE_NAME_IN_AD)
+#endif
+
 #define ZMK_ADV_CONN_NAME                                                                          \
-    BT_LE_ADV_PARAM(BT_LE_ADV_OPT_CONNECTABLE | BT_LE_ADV_OPT_ONE_TIME | BT_LE_ADV_OPT_USE_NAME |  \
-                        BT_LE_ADV_OPT_FORCE_NAME_IN_AD,                                            \
+    BT_LE_ADV_PARAM(BT_LE_ADV_OPT_CONNECTABLE | BT_LE_ADV_OPT_ONE_TIME | ZMK_ADV_NAME_OPTS,       \
                     BT_GAP_ADV_FAST_INT_MIN_2, BT_GAP_ADV_FAST_INT_MAX_2, NULL)
 
 static struct zmk_ble_profile profiles[ZMK_BLE_PROFILE_COUNT];
@@ -71,11 +76,16 @@ BUILD_ASSERT(
     "ERROR: BLE device name is too long. Max length: " STRINGIFY(CONFIG_BT_DEVICE_NAME_MAX));
 
 static struct bt_data zmk_ble_ad[] = {
-    BT_DATA_BYTES(BT_DATA_GAP_APPEARANCE, 0xC1, 0x03),
+#if IS_ENABLED(CONFIG_ZMK_BLE_ADV_APPEARANCE)
+    BT_DATA_BYTES(BT_DATA_GAP_APPEARANCE, (CONFIG_BT_DEVICE_APPEARANCE & 0xff),
+                  ((CONFIG_BT_DEVICE_APPEARANCE >> 8) & 0xff)),
+#endif
     BT_DATA_BYTES(BT_DATA_FLAGS, (BT_LE_AD_GENERAL | BT_LE_AD_NO_BREDR)),
+#if IS_ENABLED(CONFIG_ZMK_BLE_ADV_SERVICE_UUIDS)
     BT_DATA_BYTES(BT_DATA_UUID16_SOME, 0x12, 0x18, /* HID Service */
                   0x0f, 0x18                       /* Battery Service */
                   ),
+#endif
 };
 
 #if IS_ENABLED(CONFIG_ZMK_SPLIT_BLE) && IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
