+config ZMK_BLE_IDENTITY_ADDR
+    string "Override the BLE identity address (static random, e.g. F2:4B:1E:7A:33:C5)"
+    default ""
+    help
+      Empty keeps the chip's factory address. Flash settings_reset first when
+      changing it, so no identity stored in flash takes precedence.
+
 config ZMK_BLE_PASSKEY_ENTRY
     bool "Require passkey entry on the keyboard to complete pairing"
     select RING_BUFFER
diff --git a/app/src/ble.c b/app/src/ble.c
