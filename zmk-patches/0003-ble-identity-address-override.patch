--- a/app/src/ble.c
+++ b/app/src/ble.c
@@ -741,7 +741,26 @@ static int zmk_ble_complete_startup(void) {
 }
 
 static int zmk_ble_init(void) {
-    int err = bt_enable(NULL);
+    int err;
+
+#if defined(CONFIG_ZMK_BLE_IDENTITY_ADDR)
+    if (sizeof(CONFIG_ZMK_BLE_IDENTITY_ADDR) > 1) {
+        bt_addr_le_t id_addr;
+
+        err = bt_addr_le_from_str(CONFIG_ZMK_BLE_IDENTITY_ADDR, "random", &id_addr);
+        if (err) {
+            LOG_ERR("Invalid CONFIG_ZMK_BLE_IDENTITY_ADDR (%d)", err);
+        } else {
+            /* Before bt_enable() this replaces the default identity address. */
+            err = bt_id_create(&id_addr, NULL);
+            if (err < 0) {
+                LOG_ERR("Failed to set identity address (%d)", err);
+            }
+        }
+    }
+#endif
+
+    err = bt_enable(NULL);
 
     if (err < 0 && err != -EALREADY) {
