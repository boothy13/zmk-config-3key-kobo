diff --git a/app/Kconfig b/app/Kconfig
index 6b4e3509..2dbfa9bf 100644
--- a/app/Kconfig
+++ b/app/Kconfig
@@ -145,7 +145,7 @@ menuconfig ZMK_BLE
     bool "BLE (HID over GATT)"
     select BT
     select BT_SMP
-    select BT_SMP_SC_PAIR_ONLY
+    select BT_SMP_SC_PAIR_ONLY if !ZMK_BLE_ALLOW_LEGACY_PAIRING
     select BT_SMP_APP_PAIRING_ACCEPT
     select BT_PERIPHERAL
     select BT_DIS
@@ -175,6 +175,14 @@ config ZMK_BLE_EXPERIMENTAL_FEATURES
     help
       Enables experimental connection changes and security features.
 
+config ZMK_BLE_ALLOW_LEGACY_PAIRING
+    bool "Allow BLE legacy pairing for hosts without LE Secure Connections"
+    help
+      ZMK normally refuses any host that cannot do LE Secure Connections
+      pairing. Some embedded Bluetooth stacks (e.g. e-readers) only offer
+      legacy pairing. Enabling this lets those hosts pair; hosts that support
+      Secure Connections still use it.
+
 config ZMK_BLE_PASSKEY_ENTRY
     bool "Require passkey entry on the keyboard to complete pairing"
     select RING_BUFFER
